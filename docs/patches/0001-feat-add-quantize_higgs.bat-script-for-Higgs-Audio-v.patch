From faf62de03c26490215c3858021886d2b5d1683b9 Mon Sep 17 00:00:00 2001
From: Richard Pinedo <richard.pinedo@yahoo.com>
Date: Sun, 26 Jul 2026 00:01:50 -0400
Subject: [PATCH 1/3] feat: add quantize_higgs.bat script for Higgs Audio v3
 GGUF quantization pipeline

---
 quantize_higgs.bat | 51 ++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 51 insertions(+)
 create mode 100644 quantize_higgs.bat

diff --git a/quantize_higgs.bat b/quantize_higgs.bat
new file mode 100644
index 00000000..7adc1037
--- /dev/null
+++ b/quantize_higgs.bat
@@ -0,0 +1,51 @@
+@echo off
+title audio.cpp - Higgs Audio v3 Quantization Pipeline
+cd /d "%~dp0"
+
+echo ============================================================
+echo      audio.cpp - Higgs Audio v3 GGUF Quantizer Script      
+echo ============================================================
+echo:
+
+set ROOT_DIR=%~dp0
+set HIGGS_SRC_DIR=C:\Users\h4rdc\Documents\Github\coding-agent\chatterbox\higgs\higgs-audio-v3-tts-4b-fp8
+set SPEC_FILE=%ROOT_DIR%model_specs\higgs_audio_tts.json
+set OUTPUT_DIR=%ROOT_DIR%models\Higgs-GGUF
+set OUTPUT_GGUF=%OUTPUT_DIR%\higgs-audio-q8_0.gguf
+set GGUF_TOOL=%ROOT_DIR%build\windows-cuda-release\bin\audiocpp_gguf.exe
+
+if not exist "%OUTPUT_DIR%" (
+    mkdir "%OUTPUT_DIR%"
+)
+
+if not exist "%GGUF_TOOL%" (
+    echo [ERROR] audiocpp_gguf.exe binary not found at: %GGUF_TOOL%
+    echo Please build audio.cpp first using CMake.
+    pause
+    exit /b 1
+)
+
+echo [1/2] Quantizing Higgs Audio v3 weights to Q8_0 GGUF...
+echo Source     : %HIGGS_SRC_DIR%
+echo Output GGUF: %OUTPUT_GGUF%
+echo:
+
+"%GGUF_TOOL%" ^
+  --input "%HIGGS_SRC_DIR%\model.safetensors" ^
+  --root "%HIGGS_SRC_DIR%" ^
+  --model-spec "%SPEC_FILE%" ^
+  --output "%OUTPUT_GGUF%" ^
+  --type q8_0 ^
+  --keep-type "embeddings*=orig" ^
+  --overwrite
+
+if %errorlevel% equ 0 (
+    echo.
+    echo [SUCCESS] Higgs Audio Q8_0 GGUF quantized successfully!
+    echo Output File: %OUTPUT_GGUF%
+) else (
+    echo.
+    echo [ERROR] Quantization failed with error code %errorlevel%.
+)
+
+pause
-- 
