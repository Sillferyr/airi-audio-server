Subject: [PATCH 2/3] feat(higgs_audio_tts): implement
 IStreamingVoiceTaskSession for native real-time streaming

---
 .../engine/models/higgs_audio_tts/session.h   | 19 +++-
 src/models/higgs_audio_tts/loader.cpp         |  8 +-
 src/models/higgs_audio_tts/session.cpp        | 94 ++++++++++++++++++-
 3 files changed, 114 insertions(+), 7 deletions(-)

diff --git a/include/engine/models/higgs_audio_tts/session.h b/include/engine/models/higgs_audio_tts/session.h
index 6b19ff2a..1ca1f12c 100644
--- a/include/engine/models/higgs_audio_tts/session.h
+++ b/include/engine/models/higgs_audio_tts/session.h
@@ -17,7 +17,8 @@ namespace engine::models::higgs_audio_tts {
 
 class HiggsTTSSession final
     : public runtime::RuntimeSessionBase
-    , public runtime::IOfflineVoiceTaskSession {
+    , public runtime::IOfflineVoiceTaskSession
+    , public runtime::IStreamingVoiceTaskSession {
 public:
     HiggsTTSSession(
         runtime::TaskSpec task,
@@ -30,6 +31,15 @@ public:
     void prepare(const runtime::SessionPreparationRequest & request) override;
     runtime::TaskResult run(const runtime::TaskRequest & request) override;
 
+    runtime::StreamingPolicy streaming_policy() const override;
+    void start_stream(const runtime::TaskRequest & request) override;
+    std::optional<runtime::StreamEvent> next_stream_event() override;
+    void set_stream_event_sink(runtime::StreamEventCallback sink) override;
+    runtime::TaskResult finish_stream() override;
+    void reset() override;
+    runtime::StreamEvent process_audio_chunk(const runtime::AudioChunk & chunk) override;
+    runtime::TaskResult finalize() override;
+
 private:
     struct ReferenceCacheEntry {
         HiggsCodecEncodeOutput codes;
@@ -74,6 +84,13 @@ private:
     std::unique_ptr<HiggsGenerator> generator_;
     runtime::CacheSlots<ReferenceCacheKey, ReferenceCacheEntry, ReferenceCacheKeyEqual> reference_cache_;
     std::optional<ReferenceCacheEntry> uncached_reference_;
+
+    bool stream_started_ = false;
+    std::vector<runtime::TaskRequest> stream_chunks_;
+    size_t stream_chunk_index_ = 0;
+    runtime::AudioBuffer stream_merged_audio_;
+    const HiggsCodecEncodeOutput * stream_reference_codes_ = nullptr;
+    std::string stream_reference_text_;
 };
 
 }  // namespace engine::models::higgs_audio_tts
diff --git a/src/models/higgs_audio_tts/loader.cpp b/src/models/higgs_audio_tts/loader.cpp
