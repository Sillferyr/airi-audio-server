-    written += utf8proc_decompose_char(entry_cp, dst ? dst+written : dst,
-      (bufsize > written) ? (bufsize - written) : 0, options,
-    last_boundclass);
-    if (written < 0) return UTF8PROC_ERROR_OVERFLOW;
-  }
-  return written;
