-core::TensorValue leaky_relu(
-    core::ModuleBuildContext & ctx,
-    const core::TensorValue & input,
-    float slope) {
-    const auto source = contiguous(ctx, input);
-    return core::wrap_tensor(
-        ggml_leaky_relu(ctx.ggml, source.tensor, slope, false),
-        input.shape,
-        GGML_TYPE_F32);
