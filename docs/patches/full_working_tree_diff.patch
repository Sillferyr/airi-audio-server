-TransducerScorer::TransducerScorer(
-    std::shared_ptr<const SherpaKwsAssets> assets)
-    : assets_(std::move(assets)) {
-    if (!assets_) {
-        throw std::runtime_error("sherpa KWS transducer scorer requires assets");
-    }
