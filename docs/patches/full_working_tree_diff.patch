+    const double duration_ms = audio_duration_ms(audio);
+    std::ostringstream out;
+    out << "{\"wall_ms\":" << wall_ms
+        << ",\"audio_duration_ms\":" << duration_ms
+        << ",\"rtf\":" << audio_rtf(wall_ms, duration_ms) << "}";
