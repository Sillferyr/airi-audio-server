-            flush();
-        }
-        if (!has_piece) {
-            start = piece.start_sample;
-            has_piece = true;
-        }
-        current += piece.text;
-        end = piece.start_sample + piece.duration_samples;
-    }
-    flush();
-    return words;
-}
