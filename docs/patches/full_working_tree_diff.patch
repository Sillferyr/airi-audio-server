-cat > "$stub_dir/cmake" <<'STUB'
-#!/usr/bin/env bash
-printf 'cmake %s\n' "$*" >> "$CHECK_STUB_LOG"
-exit 0
-STUB
-
-cat > "$stub_dir/xcrun" <<'STUB'
-#!/usr/bin/env bash
