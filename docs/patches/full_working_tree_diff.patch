-        } else if ((byte >> 5) == 0x6 && i + 1 < text.size() &&
-                   (static_cast<unsigned char>(text[i + 1]) >> 6) == 0x2) {
-            out.push_back(((byte & 0x1F) << 6) | (static_cast<unsigned char>(text[i + 1]) & 0x3F));
