+    out << ",\"first_audio_before_input_end\":" << (first_audio_before_input_end ? "true" : "false")
+        << ",\"request_start_to_first_audio_ms\":" << request_start_to_first_audio_ms
+        << ",\"input_end_ms\":" << input_end_ms
+        << ",\"overlap_ms\":" << overlap_ms << "}";
