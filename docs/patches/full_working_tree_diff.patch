-    std::vector<std::vector<float>> ssm_states;   // [layer][d_state*d_inner]
-    std::vector<std::vector<float>> k_cache;      // [layer][seq*kv_dim]
-    std::vector<std::vector<float>> v_cache;      // [layer][seq*kv_dim]
