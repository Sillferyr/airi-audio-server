-void zipvoice_clear_runtime(const ZipVoiceComputeDevice & device) {
-    if (!device.runtime) return;
-    std::lock_guard<std::mutex> lock(device.runtime->mutex);
-    device.runtime->model.reset();
-    device.runtime->key.clear();
