-bool same_shape(const engine::core::TensorShape & lhs, const engine::core::TensorShape & rhs) noexcept {
-    if (lhs.rank != rhs.rank) {
-        return false;
-    }
-    for (size_t i = 0; i < lhs.rank; ++i) {
-        if (lhs.dims[i] != rhs.dims[i]) {
-            return false;
-        }
-    }
-    return true;
-}
