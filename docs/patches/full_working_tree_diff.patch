-namespace {
-class OwnedHttpWorkers {
-    struct Worker {
-        explicit Worker(UniqueSocket socket) : socket(std::move(socket)) {}
-        UniqueSocket socket;
-        std::mutex socket_mutex;
-        std::thread thread;
-        std::atomic<bool> done{false};
-        std::atomic<bool> stopping{false};
-    };
-public:
-    ~OwnedHttpWorkers() { drain(); }
-    void start(UniqueSocket socket, IHttpHandler & handler, uint64_t max_body_bytes) {
-        auto worker = std::make_unique<Worker>(std::move(socket));
-        auto * pointer = worker.get();
-        // Publish ownership before creating a thread. Allocation/thread creation
-        // failure closes the accepted connection and drains existing workers.
-        workers_.push_back(std::move(worker));
-        // Nonblocking sends/receives ensure cancellation polls cannot enter an
-        // uninterruptible socket call after a readiness check.
-#ifdef _WIN32
-        u_long nonblocking = 1;
-        if (ioctlsocket(pointer->socket.get(), FIONBIO, &nonblocking) != 0) {
-            throw std::runtime_error("could not configure parallel HTTP socket");
-        }
-#else
-        const int flags = fcntl(pointer->socket.get(), F_GETFL, 0);
-        if (flags < 0 || fcntl(pointer->socket.get(), F_SETFL, flags | O_NONBLOCK) < 0) {
-            throw std::runtime_error("could not configure parallel HTTP socket");
-        }
-#endif
-        pointer->thread = std::thread([pointer, &handler, max_body_bytes] {
-            connection_stopping = &pointer->stopping;
-            connection_send_timeout_ms = 0;
-            try { handle_client(pointer->socket.get(), handler, max_body_bytes); }
-            catch (...) { std::cerr << "parallel HTTP worker failed while handling an error\n"; }
-            {
-                std::lock_guard<std::mutex> lock(pointer->socket_mutex);
-                pointer->socket = UniqueSocket{};
-            }
-            connection_stopping = nullptr;
-            pointer->done.store(true, std::memory_order_release);
-        });
-    }
-    void reap() {
-        auto it = workers_.begin();
-        while (it != workers_.end()) {
-            if (!(*it)->done.load(std::memory_order_acquire)) { ++it; continue; }
-            if ((*it)->thread.joinable()) { (*it)->thread.join(); }
-            it = workers_.erase(it);
-        }
-    }
-    void drain() noexcept {
-        // Interrupt socket reads/writes before joining. The per-worker mutex
-        // prevents shutdown racing close and hitting a reused socket handle.
-        for (const auto & worker : workers_) {
-            worker->stopping.store(true, std::memory_order_release);
-            std::lock_guard<std::mutex> lock(worker->socket_mutex);
-            if (worker->socket.get() == kInvalidSocket) { continue; }
-#ifdef _WIN32
-            shutdown(worker->socket.get(), SD_BOTH);
-#else
-            shutdown(worker->socket.get(), SHUT_RDWR);
-#endif
-        }
-        // No worker/registry/model lock is held while waiting for inference or
-        // a deferred callback. The runtime outlives all these joined workers.
-        for (const auto & worker : workers_) {
-            if (worker->thread.joinable()) { worker->thread.join(); }
-        }
-        workers_.clear();
-    }
-private:
-    std::vector<std::unique_ptr<Worker>> workers_;
-};
-} // namespace
