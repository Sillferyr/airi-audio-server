-           ends_with(".norm.log_scale") ||
-           ends_with(".bypass_scale") ||
-           name.find(".downsample.weights") !=
-               std::string_view::npos ||
-           name.find(".downsample_output.weights") !=
-               std::string_view::npos ||
-           ends_with(".chunk_scale_left") ||
-           ends_with(".chunk_scale_right");
-}
