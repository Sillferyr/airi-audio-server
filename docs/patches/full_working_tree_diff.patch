-int32_t get_i32(const std::vector<std::byte> & in, size_t offset) {
-    uint32_t bits = 0;
-    for (int i = 0; i < 4; ++i) {
-        bits |= static_cast<uint32_t>(in[offset + static_cast<size_t>(i)]) << (8 * i);
-    }
-
-    return static_cast<int32_t>(bits);
-}
