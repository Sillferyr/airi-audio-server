-  if (value == nullptr || value->is_null()) {
-    return default_value;
-  }
-  if (value->is_bool()) {
-    return value->as_bool();
-  }
-  if (value->is_string()) {
-    const auto str = value->as_string();
-    if (str == "true" || str == "1") {
-      return true;
-    }
