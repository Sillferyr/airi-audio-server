-                    KeptPrompt shared;
-                    if (from != kept.end()) {
-                        shared.assign(from->begin(), from->begin() + static_cast<std::ptrdiff_t>(matched));
-                    }
-
-                    into = &add_prompt(std::move(shared));
-                }
