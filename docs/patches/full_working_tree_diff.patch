-// Whether two questions have the same samples, bit for bit.
-bool same_samples(const std::vector<float> & a, const std::vector<float> & b) {
-    return a.size() == b.size() && (a.empty() || std::memcmp(a.data(), b.data(), a.size() * sizeof(float)) == 0);
