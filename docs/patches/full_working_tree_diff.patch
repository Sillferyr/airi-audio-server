-core::TensorValue contiguous(
-    core::ModuleBuildContext & ctx,
-    const core::TensorValue & value) {
-    if (core::has_backend_addressable_layout(value.tensor)) {
-        return value;
-    }
-    return core::wrap_tensor(
-        ggml_cont(ctx.ggml, value.tensor),
-        value.shape,
-        value.type);
-}
