-    int64_t steps = 0;
-    for (int64_t layer = 0; layer < config.lfm.num_layers(); ++layer) {
-        steps += config.lfm.is_attention_layer(layer) ? config.sliding_window - 1 : config.lfm.conv_kernel_size - 1;
