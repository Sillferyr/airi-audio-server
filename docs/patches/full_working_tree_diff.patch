-// depthformer's norms and RoPE use MHA's defaults (model/transformer.py).
-constexpr int64_t kDetokenizerUpsample = 6;
-constexpr int64_t kDetokenizerHopLength = 320;
-constexpr int kDetokenizerSampleRate = 24000;
