-            repeated.insert(repeated.end(), conditioning.begin(), conditioning.end());
-            for (int64_t b = 0; b < batch; ++b) {
-                for (int i = 0; i < 128; ++i) {
-                    const float phase = static_cast<float>(timesteps[step]) * std::exp(-std::log(10000.0F) * static_cast<float>(i) / 128.0F);
