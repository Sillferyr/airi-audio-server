-size_t occurrences(const std::string & text, const std::string & needle) {
-    size_t found = 0;
-    for (auto at = text.find(needle); at != std::string::npos; at = text.find(needle, at + needle.size())) {
-        ++found;
-    }
-
-    return found;
-}
