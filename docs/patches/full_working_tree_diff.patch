-core::TensorValue duration_conditioning(
-    core::ModuleBuildContext & ctx,
-    const PiperTtsBackendWeights & weights,
-    const PiperTtsConfig & config,
-    const core::TensorValue & hidden) {
-    auto value = conv1d(
-        ctx,
-        weights,
-        hidden,
