-        int64_t conditioning_sample_capacity = 0;
-        int64_t harmonic_dims = 0;
-        int n_threads = 1;
-        bool use_device_backend = false;
-        audio::STFTConfig stft_config = {};
-        std::vector<float> source_signal;
-        std::vector<float> valid_phase_coarse;
