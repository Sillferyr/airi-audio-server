-KittenSynthesisInput build_kitten_synthesis_input(const runtime::Transcript &text,
-                                                  const KittenFrontendSessionState &state, const KittenAssets &assets,
-                                                  const engine::audio::EspeakPhonemizer &phonemizer) {
