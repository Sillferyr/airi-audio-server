-    std::ostringstream out;
-    out << "{\"unloaded\":[";
-    for (size_t i = 0; i < unloaded.size(); ++i) {
-        if (i != 0) { out << ","; }
-        out << json_quote(unloaded[i]);
-    }
-    out << "],\"not_found\":";
-    out << "[";
-    for (size_t i = 0; i < not_found.size(); ++i) {
-        if (i != 0) { out << ","; }
-        out << json_quote(not_found[i]);
-    }
-    out << "]}";
-    return json_response(out.str());
-}
