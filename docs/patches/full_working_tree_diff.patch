-      name_path.has_root_directory() || name_path.has_parent_path() ||
-      name_path.filename().string() != voice_name || voice_name == "." ||
-      voice_name == "..") {
-    return std::nullopt;
-  }
-  const auto wav = voice_dir / (voice_name + ".wav");
-  std::error_code ec;
-  if (!std::filesystem::is_regular_file(wav, ec)) {
-    return std::nullopt;
-  }
-  return wav;
