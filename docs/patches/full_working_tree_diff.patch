-std::string to_hex(const std::string & bytes) {
-    std::ostringstream out;
-    for (size_t i = 0; i < bytes.size(); ++i) {
-        out << (i == 0 ? "" : " ") << std::uppercase << std::hex << std::setw(2) << std::setfill('0')
-            << static_cast<int>(static_cast<unsigned char>(bytes[i]));
-    }
-
-    return out.str();
-}
