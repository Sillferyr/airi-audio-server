+    S3FlowSessionCache(S3FlowSessionCache &&) noexcept;
+    S3FlowSessionCache & operator=(S3FlowSessionCache &&) noexcept;
+
+    S3FlowSessionCache(const S3FlowSessionCache &) = delete;
