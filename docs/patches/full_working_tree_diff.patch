-            const int o0 = ob * 4;
-            const int no = std::min(4, c.output_channels - o0);
-            float32x4_t acc[4][4];
-            for (int j = 0; j < 4; ++j) {
-                const float32x4_t bj = vdupq_n_f32(c.bias[o0 + j]);
-                for (int q = 0; q < 4; ++q) {
-                    acc[j][q] = bj;
-                }
-            }
