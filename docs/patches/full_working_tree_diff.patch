-template <typename Fn>
-void require_throws(Fn && fn, const std::string & label) {
-    bool threw = false;
-    try {
-        fn();
-    } catch (const std::runtime_error &) {
-        threw = true;
-    }
-
-    require(threw, label + " must throw");
-}
