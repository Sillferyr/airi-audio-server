-            3,
-            1);
-        ffn = modules::ReluModule().build(ctx, ffn);
-        ffn = conv1d(
-            ctx,
-            weights,
-            ffn,
-            "enc_p.encoder.ffn_layers." + std::to_string(layer) + ".conv_2",
-            config.hidden_channels,
-            3,
-            1);
-        hidden = channel_layer_norm(
-            ctx,
-            weights,
-            add(ctx, hidden, ffn),
-            "enc_p.encoder.norm_layers_2." + std::to_string(layer));
-    }
-    return hidden;
-}
