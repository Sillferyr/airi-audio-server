-                              view_liveavatar_kv_cache(ctx, cache_->target_key(static_cast<size_t>(layer)), 0, target_cache_write_token_, heads, head_dim, "past target key"),
-                              cached_k);
-                    active_target_v = target_cache_write_token_ == 0
