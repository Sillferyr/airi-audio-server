-            (confucius4_r2t2_audio_encoder_token_count(frames) < 64) == (output_tokens_ < 64);
-        return weights_.get() == &weights && shape_matches && same_attention_kernel && backend_ == backend && compute_threads_ == std::max(1, threads);
