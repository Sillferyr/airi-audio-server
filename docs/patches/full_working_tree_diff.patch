+    int64_t sampling_rate = 24000;
+    int64_t harmonic_num = 8;
+    float sine_amp = 0.1f;
+    float noise_std = 0.003f;
+    float voiced_threshold = 10.0f;
+    float lrelu_slope = 0.1f;
