-core::TensorValue depthwise_conv1d(
-    core::ModuleBuildContext & ctx,
-    const PiperTtsBackendWeights & weights,
-    const core::TensorValue & input,
-    const std::string & prefix,
-    int padding,
-    int dilation) {
