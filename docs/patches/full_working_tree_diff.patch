-    const auto q_taps = require(weights, prefix + "q_taps", {3, 384}, layer);
-    const auto k_taps = require(weights, prefix + "k_taps", {3, 96}, layer);
-    const auto v_taps = require(weights, prefix + "v_taps", {3, 128}, layer);
