-            case 1: t = ggml_new_tensor_1d(ctx, type, d[0]); break;
-            case 2: t = ggml_new_tensor_2d(ctx, type, d[0], d[1]); break;
-            case 3: t = ggml_new_tensor_3d(ctx, type, d[0], d[1], d[2]); break;
