-def exact_ternary_blocks(tensor, bits):
-    """Encode BF16 ternary values exactly in ordinary Q4_0 or Q8_0 blocks."""
-    if bits not in (4, 8) or tensor.ndim != 2 or tensor.shape[-1] % 32:
