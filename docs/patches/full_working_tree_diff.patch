-    script_count=$((script_count + 1))
-done
-echo "ok: $BASH_BIN -n passed for $script_count scripts"
-
-# Stub the tools the scripts call so their tail runs without doing real work.
-stub_dir="$work_dir/bin"
-mkdir -p "$stub_dir"
