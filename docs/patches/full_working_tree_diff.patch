-    const int T = frames;
-    const int frames16 = (T + 15) & ~15;
-    const int padded = frames16 + workspace.max_kernel_size - 1;
-    const int cin = c.input_channels;
-    const int K = c.kernel_size;
-    const int pad = K / 2;
