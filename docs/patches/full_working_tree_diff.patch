-        }
-
-        const auto hidden = hidden_of_last_step(ctx, x, weights, config);
-        hidden_ = hidden.tensor;
-        logits_ = text_logits(ctx, hidden, weights, config).tensor;
-        ggml_set_output(hidden_);
-        ggml_set_output(logits_);
