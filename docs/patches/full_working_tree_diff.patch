-// EmiliaTokenizer
-
-EmiliaTokenizer::EmiliaTokenizer(
-    const TablePaths & tables,
-    const std::unordered_map<std::string, int32_t> & vocab,
-    const EspeakConfig & espeak)
-    : vocab_(vocab), tables_(tables), espeak_(espeak) {
