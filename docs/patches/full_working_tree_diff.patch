-struct GgmlContextDeleter {
-    void operator()(ggml_context * ctx) const noexcept { ggml_free(ctx); }
-};
-
-struct GgmlGallocrDeleter {
-    void operator()(ggml_gallocr_t alloc) const noexcept { ggml_gallocr_free(alloc); }
-};
