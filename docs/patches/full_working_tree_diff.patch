-                }
-            });
-            if (*gallocr == nullptr) {
-                throw std::runtime_error("failed to allocate Kitten generator graph tensors");
-            }
-            engine::debug::timing_log_scalar("kitten.graph.build.decoder_generator_define_ms", define_ms);
-            const double materialize_ms = measure_ms([&]() {
