-    debug::timing_log_scalar("tone_color_vc.decoder_ms", debug::elapsed_ms(started));
-    runtime::AudioBuffer output;
-    output.sample_rate = kSampleRate;
-    output.channels = 1;
-    output.samples = std::move(decoded.waveform);
-    return output;
-}
