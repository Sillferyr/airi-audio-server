-    if (!std::regex_search(body, match, speaker_pattern, std::regex_constants::match_continuous)) {
-        return "<|speaker:0|> " + text;
-    }
-    if (!reference) return text;
-    return match.str() + text.substr(0, leading) + body.substr(match.length());
-}
