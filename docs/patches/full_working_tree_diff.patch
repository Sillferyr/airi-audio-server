-// Bytes from hex such as "E0 B8", and back, so that a failure shows bytes.
-std::string from_hex(const std::string & hex) {
-    std::istringstream in(hex);
-    std::string out;
-    std::string byte;
-    while (in >> byte) {
-        out.push_back(static_cast<char>(std::stoi(byte, nullptr, 16)));
-    }
-
-    return out;
-}
